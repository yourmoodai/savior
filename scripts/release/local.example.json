{
  "schema": 1,
  "notary_timeout_seconds": 1800,
  "tools": {
    "rcodesign": "rcodesign",
    "jsign": "jsign",
    "osslsigncode": "osslsigncode",
    "openssl": "openssl",
    "node": "node",
    "npm": "npm"
  },
  "credentials": {
    "apple_p12": "SAVIOR_APPLE_P12_FILE",
    "apple_password": "SAVIOR_APPLE_PASSWORD_FILE",
    "apple_api": "SAVIOR_APPLE_API_FILE",
    "windows_keystore": "SAVIOR_WINDOWS_KEYSTORE_FILE",
    "windows_password": "SAVIOR_WINDOWS_PASSWORD_FILE",
    "windows_ca": "SAVIOR_WINDOWS_CA_FILE",
    "timestamp_ca": "SAVIOR_TIMESTAMP_CA_FILE",
    "manifest_private": "SAVIOR_MANIFEST_PRIVATE_FILE",
    "manifest_public": "SAVIOR_MANIFEST_PUBLIC_FILE"
  },
  "identities": {
    "apple": "replace_with_sha256_of_signer_certificate_der",
    "windows": "replace_with_sha256_of_signer_certificate_der",
    "node_apple": "replace_with_sha256_of_upstream_certificate_der",
    "node_windows": "replace_with_sha256_of_upstream_certificate_der"
  },
  "windows": {
    "storetype": "PKCS12",
    "alias": "replace_with_certificate_alias",
    "timestamp_url": "http://timestamp.digicert.com"
  }
}
